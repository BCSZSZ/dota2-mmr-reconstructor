<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Dota2MmrReconstructor</AssemblyName>
    <RootNamespace>Dota2MmrCollector</RootNamespace>
    <Product>Dota 2 MMR Reconstructor</Product>
    <Version>0.3.0</Version>
    <Description>Download authenticated Dota 2 GC history and generate a reconstructed MMR curve.</Description>
    <RepositoryUrl>https://github.com/BCSZSZ/dota2-mmr-reconstructor</RepositoryUrl>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="SteamKit2" Version="3.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\tools\mmr-table-viewer.html"
                      Link="Assets\mmr-table-viewer.html"
                      LogicalName="Dota2MmrCollector.Assets.mmr-table-viewer.html" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="licenses\SteamKit2-LGPL-2.1.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
